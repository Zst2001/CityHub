# MySQL (also used by Docker Compose)
MYSQL_DATABASE=cityhub
MYSQL_USER=cityhub
MYSQL_PASSWORD=replace_with_a_local_database_password
MYSQL_ROOT_PASSWORD=replace_with_a_local_root_password
DB_URL=jdbc:mysql://127.0.0.1:3306/cityhub?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=cityhub
DB_PASSWORD=replace_with_a_local_database_password

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Alibaba Cloud Bailian / DashScope-compatible Qwen
ALIYUNCS_API_KEY=replace_with_your_dashscope_api_key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen3.7-flash

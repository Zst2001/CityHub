# Shared local database configuration
DB_USERNAME=root
DB_PASSWORD=your_database_password

# Redis configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_or_leave_empty

# Required by the consultant module when using the DashScope-compatible models
ALIYUNCS_API_KEY=your_dashscope_api_key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen3.7-flash
